<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mo.corecraft</groupId>
        <artifactId>corecraft</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>corecraft-common</artifactId>
    <name>corecraft-common</name>
    <description>corecraft-common</description>

    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 校验相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring 的基础上下文（@Component / @Configuration / @DateTimeFormat 等）。
             ⚠️ **显式声明，不靠传递**：corecraft-common 里用了
             `org.springframework.format.annotation.DateTimeFormat`（model/query/KpTopicQuery），
             而它之前是**靠 spring-boot-starter-cache 传递进来的** ——
             依赖传递进来的东西随时会跟着别的依赖的调整消失（一次无关的升级就能编译失败）。
             版本由父 POM 的 Boot BOM 管，这里不写 version。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- 外部 HTTP 调用的统一出口（utils/HttpExecutor）。
             用 httpclient5 而不是 4.x：Spring Boot 3.2 只统一管理 5.x 的版本，
             4.x 的 org.apache.httpcomponents:httpclient 得自己钉版本号。 -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

    </dependencies>

</project>
